#: catalog/forms.py:20 catalog/models.py:481
#: catalog/templates/measure_detail.html:38
msgid "Application potential"
msgstr "Aplikační potenciál"

#: catalog/forms.py:21 catalog/templates/measure_detail.html:38
msgid ""
"Indicates how easily and widely the measure can be applied.&#10;S = limited, "
"specific conditions&#10;M = commonly applicable&#10;L = highly universal and "
"widely usable"
msgstr ""
"Vyjadřuje, jak snadno a široce lze opatření uplatnit v praxi. &#10;S = "
"omezené, specifické podmínky&#10;M = běžně použitelné v řadě situací&#10;L = "
"velmi univerzální, široce aplikovatelné"

#: catalog/forms.py:24 catalog/models.py:497
#: catalog/templates/measure_detail.html:39
msgid "Scale / extent"
msgstr "Rozsah / velikost"

#: catalog/forms.py:25 catalog/templates/measure_detail.html:39
msgid ""
"Describes the typical spatial scale of implementation.&#10;S = local, small-"
"scale&#10;M = medium-scale&#10;L = large-scale, landscape level"
msgstr ""
"Popisuje typickou plošnou nebo prostorovou velikost realizace.&#10;S = "
"lokální, malý zásah&#10;M = střední územní rozsah&#10;L = rozsáhlé, krajinné "
"měřítko"

#: catalog/forms.py:28 catalog/models.py:513
#: catalog/templates/measure_detail.html:40
msgid "Implementation complexity"
msgstr "Náročnost realizace"

#: catalog/forms.py:29 catalog/templates/measure_detail.html:40
msgid ""
"Indicates technical, organisational and administrative complexity.&#10;S = "
"simple, low effort&#10;M = moderate complexity&#10;L = complex, high "
"implementation effort"
msgstr ""
"Vyjadřuje technickou, organizační a administrativní složitost.&#10;S = "
"jednoduché, nízké nároky&#10;M = střední náročnost&#10;L = složité, vysoké "
"nároky na přípravu"

#: catalog/forms.py:33 catalog/models.py:536
#: catalog/templates/measure_detail.html:41
msgid "Impact quantification"
msgstr "Kvantifikace dopadu"

#: catalog/forms.py:34 catalog/templates/measure_detail.html:41
msgid ""
"Information on the extent of the measure’s impact.&#10;S = low impact&#10;M "
"= medium impact&#10;L = very high impact"
msgstr ""
"Informace, do jaké míry má opatření dopad.&#10;S = malý dopad&#10;M = "
"středně velký dopad&#10;L = velmi vysoký dopad"

#: catalog/forms.py:38 catalog/models.py:552
#: catalog/templates/measure_detail.html:42
msgid "Impact time horizon"
msgstr "Časový horizont dopadu"

#: catalog/forms.py:39 catalog/templates/measure_detail.html:42
msgid ""
"Indicates when the main benefits become visible.&#10;S = short-term, rapid "
"effect&#10;M = medium-term impact&#10;L = long-term impact"
msgstr ""
"Udává, kdy se projeví hlavní přínosy opatření.&#10;S = rychlý, krátkodobý "
"účinek&#10;M = střednědobý účinek&#10;L = dlouhodobý účinek"

